PORT=3000
NODE_ENV=development
# Public HTTPS origin of the deployed app (must be https:// when NODE_ENV=production)
PUBLIC_APP_URL=http://localhost:3000
# Random string, at least 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Stripe Dashboard (test mode) > Developers > API keys > Secret key (sk_test_...)
STRIPE_SECRET_KEY=
# whsec_... from `stripe listen` (local) or the webhook endpoint in the Stripe Dashboard
STRIPE_WEBHOOK_SECRET=
DATA_DIR=./data
# Set to 1 only when running behind exactly one reverse proxy (Render, Railway, Nginx...)
TRUST_PROXY=0
# Email (SMTP). Leave SMTP_HOST empty to disable email: confirmations stay queued and transfers return 503.
SMTP_HOST=
# 587 = STARTTLS (SMTP_SECURE=false), 465 = implicit TLS (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Plain address on a domain verified with your email provider, e.g. licenses@your-domain.example
MAIL_FROM=
# Optional address shown in emails for support requests
SUPPORT_EMAIL=
