PORT=3000
NODE_ENV=development
# Public HTTPS origin of the deployed app (must be https:// when NODE_ENV=production)
PUBLIC_APP_URL=http://localhost:3000
# Random string, at least 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Stripe Dashboard (test mode) > Developers > API keys > Secret key (sk_test_...)
STRIPE_SECRET_KEY=
# whsec_... from `stripe listen` (local) or the webhook endpoint in the Stripe Dashboard
STRIPE_WEBHOOK_SECRET=
DATA_DIR=./data
# Set to 1 only when running behind exactly one reverse proxy (Render, Railway, Nginx...)
TRUST_PROXY=0
